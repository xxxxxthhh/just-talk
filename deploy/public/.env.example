# Public trial configuration. Copy to deploy/public/.env (git-ignored).

# Azure AI Speech resource used for all visitors. Prefer a dedicated resource
# so its key can be rotated without touching personal use.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region
AZURE_TTS_VOICE=en-US-JennyNeural

# Exact public origin(s) allowed to make state-changing requests.
PUBLIC_ALLOWED_ORIGINS=https://justtalk.example.com
CORS_ORIGINS=https://justtalk.example.com
# Only trust this header when the app is reachable solely through the tunnel.
PUBLIC_CLIENT_IP_HEADER=CF-Connecting-IP
# Emergency switch: 0 stops all Azure calls (scoring and playback).
PUBLIC_SCORING_ENABLED=1

MAX_AUDIO_SECONDS=30
MAX_LONG_AUDIO_SECONDS=90

# Usage caps (UTC windows). Seconds of decoded audio / TTS characters.
PUBLIC_GLOBAL_MONTHLY_SCORE_SECONDS=14400
PUBLIC_GLOBAL_MONTHLY_TTS_CHARS=100000
PUBLIC_GLOBAL_DAILY_SCORE_SECONDS=1800
PUBLIC_GLOBAL_DAILY_TTS_CHARS=5000
PUBLIC_VISITOR_DAILY_SCORE_SECONDS=180
PUBLIC_VISITOR_DAILY_TTS_CHARS=1000
# Attempt caps also bound many tiny or failing requests.
PUBLIC_GLOBAL_MONTHLY_SCORE_ATTEMPTS=1500
PUBLIC_GLOBAL_MONTHLY_TTS_ATTEMPTS=3000
PUBLIC_GLOBAL_DAILY_SCORE_ATTEMPTS=120
PUBLIC_GLOBAL_DAILY_TTS_ATTEMPTS=200
PUBLIC_VISITOR_DAILY_SCORE_ATTEMPTS=20
PUBLIC_VISITOR_DAILY_TTS_ATTEMPTS=40

# Visitors.
PUBLIC_VISITOR_TTL_DAYS=7
PUBLIC_MAX_ACTIVE_VISITORS=300
PUBLIC_NEW_VISITORS_PER_HOUR=30
PUBLIC_NEW_VISITORS_PER_CLIENT_PER_HOUR=5

# Request and content limits.
PUBLIC_MAX_UPLOAD_BYTES=5000000
PUBLIC_MAX_JSON_BYTES=262144
PUBLIC_MAX_TTS_CHARS_PER_REQUEST=600
PUBLIC_MAX_REFERENCE_CHARS=1500
PUBLIC_MAX_CONCURRENT_AZURE=2
PUBLIC_AZURE_QUEUE_WAIT_SECONDS=10

# Optional Cloudflare Turnstile on visitor creation (both values required).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
